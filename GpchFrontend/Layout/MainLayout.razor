@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject GpchFrontend.Services.ThemeService Theme
@using GpchFrontend.Services
@using GpchFrontend.Components

@if (!EsHome)
{
    <div class="florselector-wrapper">
        <ThemeFlower Size="120" />
    </div>
}

<div class="page">
    @if (IsLoading)
    {
        <div class="gpch-transicion-wrapper">
            <FlorSVG Size="120" />
        </div>
    }
    else
    {
        <main>
            <div class="gpch-layout"
                 style="background-image: @(Theme?.FondoActual ?? "none");
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                background-color: @FondoTema;">
                <AppBar />
                <div class="gpch-body">
                    @Body
                </div>
                <Footer />
            </div>
        </main>
    }
</div>

@code {
    private int ThemeFontSizeBase = ThemePalette.GetFontSizeBase("rojo");
    private int ThemeSpacingBase = ThemePalette.GetSpacingBase("rojo");
    private bool IsLoading = false;

    private string FondoTema = ThemePalette.GetColor("rojo");
    private bool EsHome => Navigation.ToBaseRelativePath(Navigation.Uri) == "";

    protected override void OnInitialized()
    {
        try
        {
            Theme.OnThemeChanged += ActualizarEstilos;

            Navigation.LocationChanged += (_, __) =>
            {
                IsLoading = true;
                StateHasChanged();

                _ = Task.Run(async () =>
                {
                    await Task.Delay(600); // duración de la transición
                    IsLoading = false;
                    await InvokeAsync(StateHasChanged);
                });
            };

            ActualizarEstilos();

            var host = Navigation.Uri;
            if (!string.IsNullOrEmpty(host) && host.Contains("goerlich-pharma.cl"))
            {
                Navigation.NavigateTo("https://gpch.cl", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en OnInitialized: {ex.Message}");
        }
    }

    private void ActualizarEstilos()
    {
        try
        {
            var tema = Theme?.TemaActual ?? "rojo";
            ThemeFontSizeBase = ThemePalette.GetFontSizeBase(tema);
            ThemeSpacingBase = ThemePalette.GetSpacingBase(tema);
            FondoTema = ThemePalette.GetColor(tema);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al actualizar estilos: {ex.Message}");
            FondoTema = ThemePalette.GetColor("rojo"); // fallback seguro
        }
    }
}

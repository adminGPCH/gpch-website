@using GpchFrontend.Services

@inject GpchFrontend.Services.ThemeService Theme
@inject NavigationManager Nav
@inject IJSRuntime JS

<header class="gpch-appbar" style=@($"background-color:{ToRgba(ColorTema, 0.75)}")>
    <div class="appbar-content">
        <NavLink href="/" @onclick="PlayLogoClickSound">
            <img src="images/logo_gpch-solo-t.png"
                 alt="GPCH Logo"
                 class="appbar-logo"
                 @onmouseover="PlayLogoHoverSound" />
        </NavLink>

        <nav class="appbar-nav">
            <a style=@($"color:{ColorContraste}")
               href="/"
               @onmouseover="PlayMenuHoverSound"
               @onclick="PlayMenuClickSound">Inicio</a>

            <a style=@($"color:{ColorContraste}")
               href="/productos"
               @onmouseover="PlayMenuHoverSound"
               @onclick="PlayMenuClickSound">Productos</a>

            <a style=@($"color:{ColorContraste}")
               href="/contacto"
               @onmouseover="PlayMenuHoverSound"
               @onclick="PlayMenuClickSound">Contacto</a>
        </nav>

    </div>
</header>

@code {
    private string ColorTema = ThemePalette.GetColor("rojo");
    private string ColorContraste = "#000000";

    protected override void OnInitialized()
    {
        Theme.OnThemeChanged += ActualizarEstilos;
        ActualizarEstilos();

        Nav.LocationChanged += (_, args) =>
        {
            if (args.Location.EndsWith("/") && Theme.TemaActual != "azul")
            {
                Theme.CambiarTemaConFondo("azul", ThemePalette.GetBackgroundImage("azul"));
            }
        };
    }

    private void ActualizarEstilos()
    {
        var tema = Theme.TemaActual;
        ColorTema = ThemePalette.GetColor(tema);
        ColorContraste = ThemePalette.GetContraste(tema);
        StateHasChanged();
    }

    private string ToRgba(string hex, double alpha)
    {
        var color = System.Drawing.ColorTranslator.FromHtml(hex);
        return $"rgba({color.R}, {color.G}, {color.B}, {alpha})";
    }

    private async Task PlayLogoHoverSound()
    {
        Theme.CambiarTema("azul");
        if (Theme.SonidoActivo)
        await JS.InvokeVoidAsync("playSound", "/sounds/gpch_menu_hover.mp3");
    }

    private async Task PlayLogoClickSound()
    {
        if (Theme.SonidoActivo)
        await JS.InvokeVoidAsync("playSound", "/sounds/gpch_menu_clic.mp3");
    }

    private async Task PlayMenuHoverSound()
    {
        if (Theme.SonidoActivo)
        await JS.InvokeVoidAsync("playSound", "/sounds/gpch_menu_hover.mp3");
    }

    private async Task PlayMenuClickSound()
    {
        if (Theme.SonidoActivo)
        await JS.InvokeVoidAsync("playSound", "/sounds/gpch_menu_clic.mp3");
    }
}

@page "/productos"
@using GpchFrontend.Components
@using GpchFrontend.Services
@inject GpchFrontend.Services.ThemeService Theme
@inject IHttpClientFactory ClientFactory

<link href="lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="css/site.css" rel="stylesheet" />
<link href="css/productos.css" rel="stylesheet" />

<a href="/contacto" class="cotice-btn"
   style="background-color:@ColorTema; color:@ColorContraste">
    Cotice aquí
</a>

<div class="productos-wrapper">
    <section class="bloque-texto text-center mb-5">
        <h1 class="catalogo-title">Catálogo GPCH</h1>
        <p class="fw-bold mb-3">
            Tenemos una amplia gama de productos para su negocio o emprendimiento.
        </p>
        <p class="fw-bold mb-3">
            Todos de la mejor calidad y con el respaldo de GPCH.
        </p>
        <p class="fw-bold mb-0">
            Explore nuestras categorías y descubra lo que tenemos para usted.
        </p>
    </section>


    <section class="bloque-texto mt-5">
        <h3 class="text-center mb-4">Categorías de productos</h3>

        <div class="d-flex flex-wrap justify-content-center gap-4">
            @if (categorias != null)
            {
                @foreach (var cat in categorias)
                {
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h5 class="card-title">@cat.Nombre</h5>
                            <ul class="mb-3 text-start">
                                @foreach (var item in cat.Resumen)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                            <a href="@cat.PdfUrl" target="_blank" download class="btn btn-primary">
                                📄 Descargar
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </section>
</div>

@code {
    private List<CategoriaProducto> categorias;

    // Colores dinámicos del botón
    private string ColorTema = "#b71c1c";       // valor inicial
    private string ColorContraste = "#ffffff";  // valor inicial

    protected override async Task OnInitializedAsync()
    {
        var http = ClientFactory.CreateClient("Static");
        categorias = await http.GetFromJsonAsync<List<CategoriaProducto>>("docs/categorias.json");
        // Console.WriteLine($"Se cargaron {categorias?.Count} categorías");

        // Suscribirse al evento de cambio de tema
        Theme.OnThemeChanged += ActualizarEstilos;
        ActualizarEstilos();
    }

    private void ActualizarEstilos()
    {
        var tema = Theme.TemaActual;
        ColorTema = ThemePalette.GetColor(tema);
        ColorContraste = ThemePalette.GetContraste(tema);
        StateHasChanged(); // refresca la UI
    }

    public class CategoriaProducto
    {
        public string Nombre { get; set; }
        public List<string> Resumen { get; set; }
        public string PdfUrl { get; set; }
    }
}

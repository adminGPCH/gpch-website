    @if (categorias != null)
    {
        <!-- 🔹 Render dinámico con JSON -->
        <div class="gpch-grid">
            @foreach (var cat in categorias)
            {
                <div class="gpch-card">
                    <div class="gpch-card-header" style=@($"background-color:{ColorTema};")>
                        <h5 style=@($"color:{ColorContraste};")>@cat.Title</h5>
                    </div>

                    @if (!string.IsNullOrEmpty(cat.ImagenUrl) && !string.IsNullOrEmpty(cat.UrlCategoria))
                    {
                        <a href="@cat.UrlCategoria">
                            <img src="@cat.ImagenUrl" alt="@cat.Title" class="gpch-card-img" />
                        </a>
                    }

                    @if (!string.IsNullOrEmpty(cat.Abstract))
                    {
                        <p class="gpch-card-abstract">@cat.Abstract</p>
                    }

                    @if (!string.IsNullOrEmpty(cat.UrlCategoria))
                    {
                        <a href="@cat.UrlCategoria" class="gpch-btn"
                           style=@($"background-color:{ColorTema}; color:{ColorContraste};")>
                            Ver más...
                        </a>
                    }
                </div>
            }

        </div>
    }

</div>


@code {
    private List<CategoriaProducto> categorias;

    private string ColorTema = "#b71c1c";
    private string ColorContraste = "#ffffff";

    protected override async Task OnInitializedAsync()
    {
        var http = ClientFactory.CreateClient("Static");
        categorias = await http.GetFromJsonAsync<List<CategoriaProducto>>("docs/categorias.json");

        Theme.OnThemeChanged += ActualizarEstilos;
        ActualizarEstilos();
    }

    private void ActualizarEstilos()
    {
        var tema = Theme.TemaActual;
        ColorTema = ThemePalette.GetColor(tema) ?? "#b71c1c";
        ColorContraste = ThemePalette.GetContraste(tema) ?? "#ffffff";
        StateHasChanged();
    }

    public class CategoriaProducto
    {
        public string Title { get; set; }
        public string ImagenUrl { get; set; }
        public string Abstract { get; set; }
        public string UrlCategoria { get; set; }
    }
}
